{
  "manifest_version": 3,
  "name": "Urban B",
  "version": "1.5.4",
  "description": "Khung UrbanB trên PMS ezCloud (Booking OTA, Khoá G2J, Chỉ báo) và thu review OTA lên Hub UrbanB. Đăng nhập bằng tài khoản Hub.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "https://pms.ezcloudhotel.com/*",
    "https://admin.booking.com/*",
    "https://account.booking.com/*",
    "https://ycs.agoda.com/*",
    "https://portal.agoda.com/*",
    "https://ebooking.trip.com/*",
    "https://www.expediapartnercentral.com/*",
    "https://apps.expediapartnercentral.com/*",
    "https://tera.traveloka.com/*",
    "https://ha.go2joy.vn/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://urbanb.xyz/*",
    "https://hub.urbanb.vn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tera.traveloka.com/*",
        "https://apps.expediapartnercentral.com/*",
        "https://ha.go2joy.vn/*",
        "https://pms.ezcloudhotel.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pms.ezcloudhotel.com/*",
        "https://ha.go2joy.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hub.urbanb.vn/*",
        "https://urbanb.xyz/*"
      ],
      "js": [
        "hub-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "quay/*.js",
        "env.js"
      ],
      "matches": [
        "https://pms.ezcloudhotel.com/*",
        "https://ha.go2joy.vn/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Urban B",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
