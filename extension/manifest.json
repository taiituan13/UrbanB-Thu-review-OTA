{
  "manifest_version": 3,
  "name": "UrbanB — Thu review OTA",
  "version": "0.8.1",
  "description": "Đọc review từ extranet Booking, Agoda, Trip, Expedia, Traveloka, Go2Joy bằng phiên đăng nhập sẵn có và gom vào Google Sheet. Chỉ đọc.",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://admin.booking.com/*",
    "https://account.booking.com/*",
    "https://ycs.agoda.com/*",
    "https://portal.agoda.com/*",
    "https://ebooking.trip.com/*",
    "https://www.expediapartnercentral.com/*",
    "https://apps.expediapartnercentral.com/*",
    "https://tera.traveloka.com/*",
    "https://ha.go2joy.vn/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://urbanb.xyz/*",
    "https://hub.urbanb.vn/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://tera.traveloka.com/*", "https://apps.expediapartnercentral.com/*", "https://ha.go2joy.vn/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thu review OTA",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
